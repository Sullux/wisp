{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Wisp",
  "scopeName": "source.wisp",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#list"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.semicolon.wisp",
      "match": ";.*$"
    },
    "string": {
      "name": "string.quoted.single.wisp",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.wisp",
          "match": "\\\\."
        }
      ]
    },
    "number": {
      "name": "constant.numeric.wisp",
      "match": "\\b-?[0-9]+(\\.[0-9]+)?\\b"
    },
    "list": {
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.list.begin.wisp" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.list.end.wisp" }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        },
        {
          "comment": "This captures the first atom in a list as a function name.",
          "begin": "(?<=\\\\()\\s*([^\\s\\(\\\\)]+)",
          "end": "(?=[\\s\\)])",
          "beginCaptures": {
            "1": { "name": "entity.name.function.wisp" }
          }
        },
        {
          "include": "$self"
        }
      ]
    }
  }
}